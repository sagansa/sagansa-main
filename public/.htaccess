<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|pdf|heic|heif)$">
        Header always set Access-Control-Allow-Origin "https://admin.sagansa.id"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Headers "Origin, Content-Type, Accept, Range"
        Header always set Access-Control-Expose-Headers "Content-Length, Content-Type, Accept-Ranges, Content-Range"
        Header always set Cross-Origin-Resource-Policy "cross-origin"
    </FilesMatch>
</IfModule>

